GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GAS_WEBHOOK_SECRET=change-me-long-random-secret
WORKER_SECRET=change-me-long-random-worker-secret
ADMIN_API_TOKEN=change-me-long-random-admin-token
# Vercel Cron auth secret. Vercel auto-injects this when cron is configured.
CRON_SECRET=change-me-long-random-cron-secret
DATABASE_URL=postgresql://postgres:***@db.project.supabase.co:5432/postgres
SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
SUPABASE_ANON_KEY=change-me
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
NEXTAUTH_SECRET=change-me-long-random-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REFRESH_TOKEN=change-me
GROK_API_KEY=change-me
ELEVENLABS_API_KEY=change-me
SUNO_API_KEY=change-me
IDEOGRAM_API_KEY=change-me
OPENAI_API_KEY=change-me
PEXELS_API_KEY=change-me
BLOB_READ_WRITE_TOKEN=change-me
MAX_CONCURRENT_JOBS=3
DEFAULT_RETRY_LIMIT=3
COST_ALERT_THRESHOLD_USD=10

# Remote SSH worker (ffmpeg render host)
SSH_HOST=192.168.18.210
SSH_PORT=22
SSH_USER=rizqunaid
# Provide ONE of the following auth methods:
# Option A: private key contents (PEM, newlines escaped as \n for single-line envs)
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PASSPHRASE=
# Option B: password (NOT recommended; use only for dev)
SSH_PASSWORD=
SSH_READY_TIMEOUT_MS=20000
WORKER_REMOTE_DIR=~/sibermas-worker/output
WORKER_PUBLIC_BASE_URL=https://sibermas.rizquna.id/generated

# YouTube upload guard
MAX_VIDEO_UPLOAD_BYTES=262144000
ALLOWED_VIDEO_HOSTS=supabase.co,public.blob.vercel-storage.com,sibermas.rizquna.id
